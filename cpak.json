{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "MAME",
  "description": "Emulate arcade machines and historical computer systems.",
  "version": "0.285",
  "image": "ghcr.io/containerpak/mame@sha256:ebc39201fe991cf15e3f56a7e586a569f213d83b2f59129c2c7f508015700ce4",
  "binaries": [
    "/usr/games/mame"
  ],
  "desktop_entries": [
    "/usr/share/applications/mame.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceInput": true,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "hostActions": [],
    "filesystem": [
      {
        "path": "xdg-documents",
        "access": "read-write"
      },
      {
        "path": "xdg-download",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": true,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
